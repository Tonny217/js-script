
 // @name Universal Web Security Auditor
 // @description Passive login and XSS security checks
 // @match *://*/*

(() => {
  if (window.__webAuditRunning) return;
  window.__webAuditRunning = true;

  console.log("=== Web Security Audit ===");
  console.log("Domain:", location.hostname);
  console.log("HTTPS:", location.protocol === "https:");

  // Inspect forms
  document.querySelectorAll("form").forEach((form, i) => {
    console.log("Form:", i + 1);
    console.log("Method:", form.method);
    console.log("Action:", form.action);

    if (form.querySelector('[type="password"]')) {
      console.log("Login form detected");

      if (location.protocol !== "https:") {
        console.warn("Warning: Login page is not HTTPS");
      }
    }
  });

  // Inspect password fields without reading their values
  document.querySelectorAll('input[type="password"]')
    .forEach(input => {
      console.log("Password autocomplete:", input.autocomplete);
    });

  // Inspect cookies visible to JavaScript
  console.log("JS-visible cookies:", document.cookie);

  // Inspect security-related response headers
  console.log(
    "Security headers must be checked in Network responses."
  );

  console.log("=== Audit complete ===");
})();
